{
  "name": "inkboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:sdk": "vite build --config sdk/vite.config.ts && tsc -p sdk/tsconfig.json",
    "mcp": "node mcp/server.mjs",
    "deploy": "sh scripts/deploy.sh"
  },
  "dependencies": {
    "@fontsource/shantell-sans": "^5.3.0",
    "idb-keyval": "^6.2.1",
    "mathjax-full": "^3.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "typescript": "^5.6.0",
    "vite": "latest",
    "zod": "^4.6.7"
  }
}
